// Likely Weather data model. Forecast is range-partitioned by week on issueTime (see the init migration and
// src/partitions.ts); Prisma sees it as one table.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  OK
  PARTIAL
  FAILED
}

enum RunOrigin {
  SCHEDULED
  PREVIEW
  IMPORT
}

model City {
  id             Int        @id // Open-Meteo geocoding id
  slug           String     @unique // "kharkiv-ua-706483"
  name           String // English name from the geocoder
  nameLocal      Json? // {uk: "Харків", es: "Járkov", ...}
  admin1         String?
  admin1Local    Json? // {uk: "Харківська область", ...}; null until the API fills it in
  country        String
  countryCode    String // ISO 3166-1 alpha-2
  lat            Float
  lon            Float
  elevationM     Float?
  timezone       String
  population     Int?
  firstTrackedAt DateTime   @default(now()) // when someone first opened it
  forecasts      Forecast[]
  snapshots      Snapshot[]
  archiveHours   ArchiveHour[]
}

model CollectionRun {
  id          String     @id // "preview-<cityId>-<issue>"; older rows also "scheduled-<issue>"
  issueTime   DateTime
  origin      RunOrigin // PREVIEW since collection is on demand only
  cityId      Int? // set for PREVIEW runs
  startedAt   DateTime
  finishedAt  DateTime?
  status      RunStatus
  rows        Int        @default(0)
  citiesCount Int        @default(0)
  warnings    Json?
  snapshots   Snapshot[]

  @@index([issueTime(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

// The newest run stored for a city at one issue time, with what a conditional met.no request needs next time.
model Snapshot {
  cityId            Int
  city              City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  issueTime         DateTime
  runId             String
  run               CollectionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  origin            RunOrigin
  fetchedAt         DateTime
  metnoLastModified String?

  @@id([cityId, issueTime])
}

// One model's value for one city and hour. Partitioned tables need the partition key in the primary key, so the
// natural key is the primary key.
model Forecast {
  cityId      Int
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  modelId     String // a ModelId of @fa/shared/models
  issueTime   DateTime
  validTime   DateTime
  leadHours   Int
  tempC       Float?
  feelsC      Float? // computed from temperature, humidity, wind and radiation when the run is stored
  windMs      Float?
  gustsMs     Float?
  windDirDeg  Float?
  pressureMsl Float?
  precipMm    Float? // the hour ending at validTime
  humidityPct Float?
  cloudPct    Float?
  // Not written since 2026-10-12; dropped by a later migration once the code that stopped writing them is live.
  pressureSfc Float?
  rainMm      Float?
  snowCm      Float?

  @@id([cityId, issueTime, modelId, validTime])
}

// One UTC hour of a city's past weather from Open-Meteo's Historical Weather API (ERA5 and the ECMWF IFS analysis).
// Kept for good: a place and period is fetched once and read from here afterwards.
model ArchiveHour {
  cityId      Int
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  time        DateTime
  tempC       Float?   @db.Real
  feelsC      Float?   @db.Real // Open-Meteo's apparent temperature
  windMs      Float?   @db.Real
  gustsMs     Float?   @db.Real
  windDirDeg  Float?   @db.Real
  pressureMsl Float?   @db.Real
  precipMm    Float?   @db.Real // the hour ending at time
  humidityPct Float?   @db.Real
  cloudPct    Float?   @db.Real

  @@id([cityId, time])
}
