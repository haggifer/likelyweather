{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    "ignoreIssues": {
        // The zod contract exports every schema next to its inferred type, whether or not a workspace parses with it.
        "packages/shared/src/api.ts": ["exports"],
    },
    "workspaces": {
        ".": {
            "entry": ["scripts/*.mjs"],
        },
        "apps/mobile": {
            // knip's Expo plugin expects expo-updates from app.json; EAS Update is added with the first release.
            "ignoreDependencies": ["expo-updates"],
        },
        "apps/e2e": {
            // Started by playwright.config.ts as a webServer command.
            "entry": ["fake-upstream.mjs"],
        },
        "apps/web": {},
        "infra": {
            // cdk.json runs the app as `npx tsx bin/forecast-arena.ts`.
            "entry": ["bin/forecast-arena.ts"],
            // tsx runs the CDK app; the workspace links make Turbo build the API and web bundles before the stack tests
            // read them.
            "ignoreDependencies": ["tsx", "@fa/api", "@fa/web"],
        },
        // Internal packages: a package export that no workspace imports is dead code, not public API.
        "packages/api-client": {
            "includeEntryExports": true,
        },
        "packages/chart-core": {
            "includeEntryExports": true,
        },
        "packages/charts": {
            "includeEntryExports": true,
        },
        "packages/db": {
            "includeEntryExports": true,
            // Imported by the Prisma client generated into the git-ignored src/generated.
            "ignoreDependencies": ["@prisma/client"],
        },
        "packages/fixtures": {},
        "packages/messages": {
            "includeEntryExports": true,
        },
        "packages/server": {
            "includeEntryExports": true,
            // The tests read fixture files by path; the link makes Turbo rerun them when the fixtures change.
            "ignoreDependencies": ["@fa/fixtures"],
        },
        "packages/shared": {
            "includeEntryExports": true,
        },
        "packages/ui": {
            "includeEntryExports": true,
        },
    },
}
