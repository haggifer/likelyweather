# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# leftovers of the prototype's local JSON store and run archives
/data/
/apps/web/data/
!.env.example

# Personal agent settings and notes (.claude/launch.json is shared and stays tracked)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# build and tool output
.turbo/
dist/
cdk.out/
playwright-report/
test-results/

# IDE project files (Android Studio opens the repository for the emulator and SDK Manager)
.idea/
