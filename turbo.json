{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**", "cdk.out/**", "src/generated/**"]
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"],
            "env": ["DATABASE_URL"]
        },
        "@fa/db#typecheck": {
            "dependsOn": ["build"]
        },
        "@fa/db#test": {
            "dependsOn": ["build"],
            "env": ["DATABASE_URL"]
        },
        "@fa/api#test": {
            "dependsOn": ["^build", "@fa/db#test"],
            "env": ["DATABASE_URL"]
        },
        "@fa/mobile#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/app/globals.css"]
        },
        "@fa/db#lint": {
            "dependsOn": ["build"]
        }
    }
}
