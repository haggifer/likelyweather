{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**", "cdk.out/**", "src/generated/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "@fa/db#typecheck": {
            "dependsOn": ["build"]
        },
        "@fa/db#test": {
            "dependsOn": ["build"]
        },
        "@fa/db#lint": {
            "dependsOn": ["build"]
        }
    }
}
