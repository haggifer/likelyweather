# Forecast Arena prototype — copy to .env.local
OPEN_METEO_FORECAST_BASE=https://api.open-meteo.com
OPEN_METEO_GEOCODING_BASE=https://geocoding-api.open-meteo.com
METNO_BASE=https://api.met.no
# met.no terms require a descriptive User-Agent with a real contact
METNO_USER_AGENT=forecast-arena/0.1 github.com/<user>
DATA_DIR=./data
ACTIVE_CITY_CAP=300
DORMANT_AFTER_DAYS=30
DEFAULT_LOCALE=en
# 1 = development-only Theme Lab (floating Lab button, /theme-lab gallery). 0 in production.
NEXT_PUBLIC_THEME_LAB=1
