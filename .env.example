# Copy to .env at the repository root; the API and Prisma read it. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forecastarena
REDIS_URL=redis://localhost:6379
OPEN_METEO_FORECAST_BASE=https://api.open-meteo.com
OPEN_METEO_GEOCODING_BASE=https://geocoding-api.open-meteo.com
OPEN_METEO_ARCHIVE_BASE=https://archive-api.open-meteo.com
METNO_BASE=https://api.met.no
# met.no terms require a descriptive User-Agent with a real contact
METNO_USER_AGENT=likelyweather/1.0 https://likelyweather.com <contact e-mail>
API_PORT=4000
# The contact form: the address it delivers to and the SES-verified sender. Left empty, the API logs each message
# instead of sending it; set both only to send real email through SES with your AWS profile (and AWS_REGION).
CONTACT_EMAIL=
CONTACT_FROM=
