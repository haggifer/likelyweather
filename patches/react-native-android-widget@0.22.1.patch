+    // A link opens its screen straight from the launcher. Through the widget's broadcast it would first wait for the
+    // app's process and the broadcast queue, which can hold a cold or cached app up for seconds.
+    private PendingIntent getOpenUriIntent(int id, String uri) {
+        Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(uri));
+        intent.setPackage(appContext.getPackageName());
+        intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+
+        return PendingIntent.getActivity(
+            appContext,
+            id,
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE
+        );
+    }
+
+    // A widget's own layout can hold a native clock: a view with the id `rn_widget_show_alarms` opens the phone's clock
+    // app, as a launcher's stock clock widget does.
+    private void addShowAlarmsClick(int widgetId, RemoteViews remoteWidgetView) {
+        int viewId = appContext.getResources().getIdentifier("rn_widget_show_alarms", "id", appContext.getPackageName());
+
+        if (viewId == 0) {
+            return;
+        }
+
+        Intent intent = new Intent(AlarmClock.ACTION_SHOW_ALARMS);
+        intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+
+        remoteWidgetView.setOnClickPendingIntent(
+            viewId,
+            PendingIntent.getActivity(appContext, widgetId, intent, PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE)
+        );
+    }
