+    // A widget can bring its own native layout, `rn_widget_<provider class in lower case>` in the app's resources, for
+    // views a drawn image cannot hold, such as a ticking TextClock. It keeps the default layout's ids.
+    private int getLayoutId(int widgetId) {
+        AppWidgetProviderInfo info = AppWidgetManager.getInstance(appContext).getAppWidgetInfo(widgetId);
+
+        if (info == null) {
+            return R.layout.rn_widget;
+        }
+
+        String className = info.provider.getShortClassName();
+        String name = "rn_widget_" + className.substring(className.lastIndexOf('.') + 1).toLowerCase(Locale.ROOT);
+        int layoutId = appContext.getResources().getIdentifier(name, "layout", appContext.getPackageName());
+
+        return layoutId != 0 ? layoutId : R.layout.rn_widget;
+    }
