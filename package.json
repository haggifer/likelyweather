{
    "name": "forecast-arena",
    "private": true,
    "scripts": {
        "dev": "docker compose up -d --wait && turbo run dev --filter=@fa/api --filter=@fa/web",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "knip": "knip",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:up": "docker compose up -d --wait",
        "db:migrate": "pnpm --filter @fa/db run migrate",
        "db:deploy": "pnpm --filter @fa/db run migrate:deploy",
        "db:seed": "pnpm --filter @fa/db run seed",
        "collect": "pnpm --filter @fa/collector run collect",
        "check:messages": "node scripts/check-messages.mjs",
        "e2e": "pnpm --filter @fa/e2e run e2e",
        "cdk:synth": "pnpm --filter @fa/infra run synth",
        "cdk:diff": "pnpm --filter @fa/infra run diff",
        "cdk:deploy": "pnpm --filter @fa/infra run deploy",
        "cdk:bootstrap": "pnpm --filter @fa/infra run bootstrap"
    },
    "devDependencies": {
        "eslint": "^9",
        "eslint-plugin-react-hooks": "^7",
        "knip": "6.38.0",
        "prettier": "^3.9.8",
        "prettier-plugin-organize-imports": "^4.3.0",
        "turbo": "^2.11.4",
        "typescript": "^5",
        "typescript-eslint": "^8",
        "vitest": "^5.0.1"
    },
    "packageManager": "pnpm@11.20.0"
}
