# Optional: copy to apps/web/.env.local. Next.js reads env files from this folder only, not the root .env.
# Where src/proxy.ts forwards /api/* (defaults to the local API).
API_ORIGIN=http://localhost:4000
# Shows a "Source code" link in the footer when set; inlined at build time.
# NEXT_PUBLIC_REPO_URL=https://github.com/<owner>/<repo>
