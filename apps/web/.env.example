# Optional: copy to apps/web/.env.local. Next.js reads env files from this folder only, not the root .env.
# Where src/proxy.ts forwards /api/* (defaults to the local API).
API_ORIGIN=http://localhost:4000
# Shows a "Source code" link in the footer when set; inlined at build time.
# NEXT_PUBLIC_REPO_URL=https://github.com/<owner>/<repo>
# Shows the "Get the app" bar on Android phones when set (the latest APK release); inlined at build time. Set it only
# once that release exists; the e2e phone suite covers the bar when the variable is set for both the build and the run.
# NEXT_PUBLIC_APP_PROMO_URL=https://likelyweather.com/app/likely-weather.apk
