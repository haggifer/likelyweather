{
    "name": "@fa/mobile",
    "private": true,
    "main": "./index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "tokens": "tsx scripts/generate-tokens.ts && prettier --write src/theme/tokens.ts"
    },
    "jest": {
        "preset": "jest-expo",
        "setupFilesAfterEnv": [
            "<rootDir>/jest.setup.ts"
        ],
        "transformIgnorePatterns": [
            "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|expo-router|react-navigation|@react-navigation/.*|@formatjs/.*|intl-messageformat|use-intl))"
        ]
    },
    "dependencies": {
        "@fa/api-client": "workspace:*",
        "@fa/chart-core": "workspace:*",
        "@fa/messages": "workspace:*",
        "@fa/shared": "workspace:*",
        "@formatjs/intl-displaynames": "^7.3.15",
        "@formatjs/intl-locale": "^5.3.12",
        "@formatjs/intl-pluralrules": "^6.3.15",
        "@formatjs/intl-relativetimeformat": "^12.3.15",
        "@react-native-community/netinfo": "12.0.1",
        "@tanstack/query-async-storage-persister": "^5.104.1",
        "@tanstack/react-query": "^5.103.2",
        "@tanstack/react-query-persist-client": "^5.104.1",
        "expo": "~57.0.26",
        "expo-build-properties": "~57.0.22",
        "expo-constants": "~57.0.20",
        "expo-crypto": "~57.0.3",
        "expo-dev-client": "~57.0.19",
        "expo-linking": "~57.0.11",
        "expo-localization": "~57.0.2",
        "expo-location": "~57.0.20",
        "expo-router": "~57.0.24",
        "expo-splash-screen": "~57.0.9",
        "expo-system-ui": "~57.0.4",
        "lucide-react-native": "^1.52.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-android-widget": "^0.22.1",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-mmkv": "^4.3.2",
        "react-native-nitro-modules": "^0.37.1",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-worklets": "0.10.1",
        "use-intl": "^4.14.9"
    },
    "devDependencies": {
        "@testing-library/react-native": "^14.0.1",
        "@types/jest": "29.5.14",
        "@types/node": "^22",
        "@types/react": "~19.2.2",
        "@types/react-dom": "~19.2.2",
        "eslint": "^9",
        "jest": "~29.7.0",
        "jest-expo": "~57.0.5",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3"
    }
}
