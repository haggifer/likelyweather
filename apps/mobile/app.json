{
    "expo": {
        "name": "Likely Weather",
        "slug": "likelyweather",
        "version": "0.1.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "likelyweather",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "com.likelyweather.app",
            "icon": "./assets/expo.icon"
        },
        "android": {
            "package": "com.likelyweather.app",
            "adaptiveIcon": {
                "backgroundColor": "#ffffff",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "permissions": ["ACCESS_COARSE_LOCATION"],
            "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"]
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#ffffff",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 76,
                    "dark": {
                        "backgroundColor": "#0b1220",
                        "image": "./assets/images/splash-icon-dark.png"
                    }
                }
            ],
            "expo-localization",
            [
                "expo-build-properties",
                {
                    "android": {
                        "cmakeVersion": "4.1.2"
                    }
                }
            ],
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "Likely Weather uses your location once, when you tap Use my location, to open the nearest city.",
                    "isAndroidBackgroundLocationEnabled": false,
                    "isIosBackgroundLocationEnabled": false
                }
            ],
            "./plugins/with-widget-preview-density",
            [
                "react-native-android-widget",
                {
                    "widgets": [
                        {
                            "name": "ForecastClock",
                            "label": "Likely Weather clock",
                            "description": "The time, the date and the weather for one city",
                            "previewImage": "./assets/widgets/forecast-clock-preview.png",
                            "minWidth": "250dp",
                            "minHeight": "110dp",
                            "targetCellWidth": 4,
                            "targetCellHeight": 2,
                            "resizeMode": "horizontal|vertical",
                            "updatePeriodMillis": 1800000,
                            "widgetFeatures": "reconfigurable"
                        }
                    ]
                }
            ],
            "./plugins/with-widget-layouts",
            "./plugins/with-release-signing"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
