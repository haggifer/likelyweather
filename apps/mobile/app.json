{
    "expo": {
        "name": "Forecast Arena",
        "slug": "forecast-arena",
        "version": "0.1.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "forecastarena",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "io.github.haggifer.forecastarena",
            "icon": "./assets/expo.icon"
        },
        "android": {
            "package": "io.github.haggifer.forecastarena",
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#1e5eff",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 76
                }
            ],
            "expo-localization",
            [
                "expo-build-properties",
                {
                    "android": {
                        "cmakeVersion": "4.1.2"
                    }
                }
            ],
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "Forecast Arena uses your location once, when you tap Use my location, to open the nearest city.",
                    "isAndroidBackgroundLocationEnabled": false,
                    "isIosBackgroundLocationEnabled": false
                }
            ],
            [
                "react-native-android-widget",
                {
                    "widgets": [
                        {
                            "name": "ForecastSmall",
                            "label": "Forecast Arena",
                            "description": "Median temperature and today’s agreement for one city",
                            "minWidth": "110dp",
                            "minHeight": "50dp",
                            "targetCellWidth": 2,
                            "targetCellHeight": 1,
                            "resizeMode": "horizontal|vertical",
                            "updatePeriodMillis": 10800000,
                            "widgetFeatures": "reconfigurable"
                        },
                        {
                            "name": "ForecastMedium",
                            "label": "Forecast Arena (detailed)",
                            "description": "Temperature, the next 24 hours, wind and rain for one city",
                            "minWidth": "250dp",
                            "minHeight": "110dp",
                            "targetCellWidth": 4,
                            "targetCellHeight": 2,
                            "resizeMode": "horizontal|vertical",
                            "updatePeriodMillis": 10800000,
                            "widgetFeatures": "reconfigurable"
                        }
                    ]
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
