# Optional: copy to .env.local (git-ignored). Expo inlines EXPO_PUBLIC_* variables when Metro bundles the app.
# The API the app calls; the default is the live site. A local API on a device or emulator needs
# `adb reverse tcp:4000 tcp:4000` first.
# EXPO_PUBLIC_API_ORIGIN=http://localhost:4000
# Shows a "Source code" link in Settings when set, like the web footer's NEXT_PUBLIC_REPO_URL.
# EXPO_PUBLIC_REPO_URL=https://github.com/<owner>/<repo>
